PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/thegoodfellas
JWT_SECRET=change-me-dev-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:4200
# Only needed once the server sits behind a reverse proxy/load balancer — see the comment
# on env.trustProxy in src/lib/env.ts before setting this in production.
TRUST_PROXY=

# Retention lead sheet sync. Share the sheet (Viewer) with the service account's email.
# Leave GOOGLE_SHEET_ID blank to keep the sync off.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# yyyy-mm-dd — ignore sheet date blocks before this day on the first sync.
GOOGLE_SHEET_IMPORT_FROM=
GOOGLE_SHEET_SYNC_MINUTES=5
