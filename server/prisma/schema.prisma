// Prisma schema for TheGoodFellas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  JUNIOR_CLOSER
  CLOSER
  ADMIN
  CLIENT
  TEAM_LEAD
  QA_JUNIOR_CLOSER
  QA_CLOSER
  RETENTION
}

// Pass/fail verdict on a QA review — see LeadReview and CallReview below. Internal
// metrics only; never read by any workflow/state-transition code.
enum ReviewOutcome {
  PASS
  FAIL
}

// NEW                — submitted by junior closer, sitting with the chosen closer
// SUBMITTED          — closer added info and submitted, waiting for admin to assign
// ASSIGNED           — admin assigned to a client, waiting for accept/reject
// ACCEPTED           — client accepted (payment tracked separately via paymentStatus)
// REJECTED           — client rejected, back with admin to edit/reassign
// RETURNED_TO_JUNIOR — admin sent it back to the junior closer to correct their intake
// RETURNED_TO_CLOSER — admin sent it back to the closer to correct their enrichment
// ASSIGNED_EXTERNAL  — admin handed it to an ExternalClient (no login, no accept/reject —
//                      terminal, like ACCEPTED, and payment-trackable the same way)
// DRAFT              — closer parked a half-baked enrichment instead of submitting; stays
//                      out of every other role's queue until the closer resumes and submits it
// CHARGED_BACK        — an ACCEPTED + PAID lead was clawed back by the client after the fact;
//                      clears clientId and resets paymentStatus/closedAt like REJECTED does, so
//                      admin can reassign it — see ChargeBack below for the money/reason record
//
// Both RETURNED_* states resubmit to SUBMITTED, i.e. straight back to the admin who
// asked for the fix rather than re-walking the pipeline — the other role's work is
// still valid, and the admin is the one waiting on the correction.
enum LeadStatus {
  NEW
  SUBMITTED
  ASSIGNED
  ACCEPTED
  REJECTED
  RETURNED_TO_JUNIOR
  RETURNED_TO_CLOSER
  ASSIGNED_EXTERNAL
  DRAFT
  CHARGED_BACK
}

// Why the closer parked the lead instead of finishing it — required when saving a draft.
enum DraftReason {
  MISSING_INFO
  CLIENT_NOT_REACHABLE
  NEEDS_FOLLOW_UP
  PENDING_DOCUMENTATION
  OTHER
}

// Secondary flag admin toggles on an ACCEPTED lead to mark it closed out.
// Independent of LeadStatus — does not gate any workflow transition.
enum PaymentStatus {
  UNPAID
  PAID
}

enum LeadNeed {
  BURIAL
  CREMATION
  LEAVE_MONEY
}

// CPA = today's full pipeline (Junior -> Closer -> Admin -> Client), unchanged.
// CPL = a lighter pipeline that skips the Closer step entirely — Junior submits it
// straight to SUBMITTED with a shorter intake field set (see CPL intake only below).
// RETENTION = AI-sourced leads submitted through the public retention intake form (no login,
// see routes/leads.routes.ts's '/retention/intake' route), imported unassigned, handed to a
// Retention person by Admin, then enriched/submitted straight into the same admin SUBMITTED
// queue as CPA/CPL — no Junior Closer or Closer step exists for it.
enum LeadType {
  CPA
  CPL
  RETENTION
}

// The client's own internal classification code for a CPL lead, picked by the Junior
// Closer at intake. Opaque to us — no business logic hangs off which value is chosen.
enum DCode {
  D1
  D2
  D3
  D4
}

enum IncomeSource {
  EMPLOYED
  SELF_EMPLOYED
  RETIRED
}

enum RetiredIncomeType {
  SSI
  SSDI
}

enum AccountType {
  CHECKING
  SAVINGS
}

enum PayerType {
  SELF
  SOMEONE_ELSE
}

// The four insurance plan types the closer picks from during enrichment. Fixed set,
// not admin-configurable — see User.levelCost etc. below for the per-client price of each.
enum PlanType {
  LEVEL
  GRADED
  MODIFIED
  GI
}

// The team channels. Membership is derived from Role, never stored per-user
// and never sent by the client — see server/src/lib/chat-rooms.ts.
enum ChatRoom {
  CLOSERS
  JUNIOR_CLOSERS
  TEAM_LEADS
  RETENTION
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  phone        String?
  role         Role
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Per-plan lead cost (USD) this CLIENT pays — set at account creation, editable after.
  // Meaningless for other roles; left null for them. Four fixed columns rather than a
  // separate pricing table since PlanType is a fixed 4-value set, not admin-configurable.
  levelCost    Int?
  gradedCost   Int?
  modifiedCost Int?
  giCost       Int?
  // Lowest monthly premium (USD) this client will accept on a lead — CLIENT accounts only,
  // set at creation, editable after like the four costs above. Shown against the client on
  // the State Sheet.
  minimumPremium Int?

  // CLIENT accounts only — whether this client can take payment via online bank transfer.
  // Checkbox at account creation; filterable on the State Sheet.
  acceptsOnlineBankPayment Boolean @default(false)

  // CLIENT accounts only — the states this client is licensed/covers and the carriers
  // they write business through. Feeds the State Sheet page (state -> clients -> carriers
  // available there), viewed by Closer/Team Lead/Admin. Meaningless for other roles, left
  // as the default empty array for them. `states` is drawn from a fixed US-states list
  // (validated server-side); `carriers` is freehand text, no fixed list — this is the
  // client's overall carrier roster, not per state. See ClientStateCarrier below for which
  // of these carriers apply in which state.
  states   String[] @default([])
  carriers String[] @default([])

  stateCarriers ClientStateCarrier[]

  submittedLeads    Lead[]        @relation("JuniorCloserLeads")
  closerLeads       Lead[]        @relation("CloserLeads")
  clientLeads       Lead[]        @relation("ClientLeads")
  retentionLeads    Lead[]        @relation("RetentionLeads")
  clientChargeBacks ChargeBack[]  @relation("ClientChargeBacks")
  chatMessages      ChatMessage[]
  chatReads         ChatRead[]
  leadReviews       LeadReview[]
  callReviewsGiven    CallReview[] @relation("CallReviewsGiven")
  callReviewsReceived CallReview[] @relation("CallReviewsReceived")

  @@index([role])
}

// Per (client, state) subset of that client's carrier roster (User.carriers) available in
// that state — e.g. Sunrise writes NRG in Alaska but MPG in Alabama. `state` must be one of
// US_STATES and one the client is licensed in (User.states); `carriers` must be a subset of
// the client's roster — both enforced in user.service.ts, not by a DB constraint.
model ClientStateCarrier {
  id       String   @id @default(cuid())
  clientId String
  state    String
  carriers String[] @default([])

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, state])
  @@index([clientId])
}

model Lead {
  id               String  @id @default(cuid())
  // Null when a Closer creates the lead from scratch (self- or AI-sourced calls) —
  // no Junior Closer was ever involved.
  juniorCloserId   String?
  // Null for a CPL lead — CPL skips the Closer step entirely, forever.
  closerId         String?
  clientId         String?
  externalClientId String?
  // Set only for RETENTION leads — who Admin handed a form-submitted lead to. Null while an
  // imported lead is still sitting unassigned in the admin retention-import queue.
  retentionId      String?

  // CPA = today's pipeline. CPL leads never leave this default field set — no
  // enrichment step exists for them, not even Admin fills in Closer-only fields.
  leadType LeadType @default(CPA)

  // ─── Shared personal info — set by Junior Closer at intake, editable by Closer during enrichment ───
  customerName     String
  maritalStatus    String?
  phone            String
  state            String
  zipcode          String?
  birthState       String?
  // No option list given in the spec — same placeholder-judgment-call pattern as
  // maritalStatus (plain string, not a Prisma enum). See REQUIREMENTS.md.
  gender           String?
  smoker           Boolean?
  dob              DateTime?
  age              Int?
  height           String?
  weight           Int?
  healthConditions String?

  // ─── Junior Closer intake only ───
  need               LeadNeed?
  incomeSource       IncomeSource?
  retiredIncomeType  RetiredIncomeType?
  natureOfDisability String?
  annualIncome       Int?
  juniorNotes        String?

  // ─── CPL intake only — set by Junior Closer, never touched by Closer or Admin ───
  dCode         DCode?
  decisionMaker Boolean?
  bankAccount   Boolean?

  // ─── Closer enrichment — contact & identity ───
  mailingAddress String?
  email          String?
  yearlyIncome   Int?
  ssn            String?
  dlStateId      String?
  doctorName     String?

  // ─── Closer enrichment — beneficiary ───
  beneficiaryRelation String?
  beneficiaryName     String?
  beneficiaryDob      DateTime?

  // ─── Closer enrichment — health ───
  medications String?

  // ─── Closer enrichment — policy ───
  carrierName     String?
  planType        PlanType?
  coverageAmount  Int?
  monthlyPremiums Int?

  // ─── Closer enrichment — billing ───
  initialDraftDate DateTime?
  futureDraftDate  DateTime?
  payer            PayerType?
  bankName         String? // Payer = SELF
  accountTitle     String? // both
  payerSocial      String? // Payer = SOMEONE_ELSE
  accountType      AccountType?
  routingNumber    String?
  accountNumber    String?

  closerNotes String?

  // Set when the closer parks a NEW/DRAFT lead instead of submitting it. Cleared on
  // final submit. See DraftReason above for the enum values.
  draftReason DraftReason?

  // ─── Admin ───
  rejectionReason String?
  // What the admin wants corrected when sending a lead back to the junior closer or
  // closer. Kept separate from rejectionReason, which is the client's reason for
  // refusing a lead — different author, different audience, and a lead can carry both.
  returnReason    String?
  paymentStatus   PaymentStatus @default(UNPAID)
  // Set when admin marks an ACCEPTED lead PAID — the lead is then considered closed.
  // Cleared if admin flips it back to UNPAID.
  closedAt        DateTime?
  // Set only when marked paid through the batch "Mark Paid" action on the admin Leads
  // page — links back to the PKR amount actually received for the batch this lead was
  // part of. Null for leads paid via the older single-lead toggle, which doesn't
  // record a PKR figure. See IncomePayment below.
  incomePaymentId String?

  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  juniorCloser   User?           @relation("JuniorCloserLeads", fields: [juniorCloserId], references: [id], onDelete: Cascade)
  closer         User?           @relation("CloserLeads", fields: [closerId], references: [id], onDelete: Cascade)
  client         User?           @relation("ClientLeads", fields: [clientId], references: [id], onDelete: SetNull)
  externalClient ExternalClient? @relation("ExternalClientLeads", fields: [externalClientId], references: [id], onDelete: SetNull)
  retention      User?           @relation("RetentionLeads", fields: [retentionId], references: [id], onDelete: Cascade)
  incomePayment  IncomePayment?  @relation(fields: [incomePaymentId], references: [id], onDelete: SetNull)
  chargeBacks    ChargeBack[]
  qaReviews      LeadReview[]

  @@index([juniorCloserId])
  @@index([closerId])
  @@index([clientId])
  @@index([externalClientId])
  @@index([retentionId])
  @@index([status])
  @@index([createdAt])
  @@index([incomePaymentId])
}

// A QA reviewer's pass/fail verdict on the data a Junior Closer or Closer submitted on
// one lead — internal metrics only, never gates the lead's own status. `role` records
// which QA lane produced it (QA_JUNIOR_CLOSER reviews intake, QA_CLOSER reviews
// enrichment) — denormalized off reviewer.role at write time, same pattern as
// ChargeBack.clientId, so history survives even if the reviewer's role later changes.
// One review per lead per lane: once written it's locked (@@unique below).
model LeadReview {
  id         String        @id @default(cuid())
  leadId     String
  reviewerId String
  role       Role
  outcome    ReviewOutcome
  comment    String?
  createdAt  DateTime      @default(now())

  lead     Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  reviewer User @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([leadId, role])
  @@index([reviewerId])
}

// A QA reviewer flagging something wrong on a live call with a Junior Closer or Closer,
// written directly against that person — no lead involved. Unlimited per person. There is
// deliberately no "pass" outcome — a call with nothing wrong just never gets a row here,
// so `comment` (what went wrong) is required, not optional. Internal metrics only.
model CallReview {
  id         String   @id @default(cuid())
  reviewerId String
  revieweeId String
  comment    String
  createdAt  DateTime @default(now())

  reviewer User @relation("CallReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User @relation("CallReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@index([revieweeId])
  @@index([reviewerId])
  @@index([createdAt])
}

// One PKR payment received against a batch of leads marked paid together via the admin
// Leads page's "Mark Paid" bulk action — one bank transfer/cash drop can cover several
// leads at once, so the PKR figure is recorded once per batch, not per lead. Feeds the
// income side of the Expenses page's income-vs-expense bookkeeping view.
model IncomePayment {
  id        String   @id @default(cuid())
  pkrAmount Int
  note      String?
  createdAt DateTime @default(now())

  leads Lead[]

  @@index([createdAt])
}

// One chargeback event against a lead that was ACCEPTED and PAID. Snapshots which
// client it was assigned to at the time (clientId), because the lead's own clientId
// gets cleared and reassigned elsewhere afterward — this is the only place that
// history survives. Mirrors IncomePayment's shape (pkrAmount + createdAt) so the
// analytics page can report real PKR figures, not just counts.
model ChargeBack {
  id        String   @id @default(cuid())
  leadId    String
  clientId  String
  pkrAmount Int
  reason    String
  createdAt DateTime @default(now())

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client User @relation("ClientChargeBacks", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([clientId])
  @@index([createdAt])
}

// Freeform bookkeeping ledger — money the business spent, tracked in PKR alongside
// IncomePayment so the admin Expenses page can show a coherent net total. Independent
// of the Lead pipeline; nothing else references this.
model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Int
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([date])
}

// A non-auth bookkeeping record for a lead destination outside the org — never logs
// in, has no password/role/tokenVersion. Admin-managed roster; leads assigned here go
// to ASSIGNED_EXTERNAL instead of the normal accept/reject-gated ASSIGNED.
model ExternalClient {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Per-plan lead cost (PKR), same shape as User.levelCost etc. above — set at creation,
  // editable after. Lets ASSIGNED_EXTERNAL leads carry real pricing instead of the 0 they
  // contributed to revenue analytics before this existed.
  levelCost    Int?
  gradedCost   Int?
  modifiedCost Int?
  giCost       Int?
  // Same coverage fields as CLIENT-role User accounts (minimumPremium, states, carriers,
  // stateCarriers, acceptsOnlineBankPayment) — an external client is priced and licensed
  // the same way a real CLIENT account is, it just has no login.
  minimumPremium           Int?
  acceptsOnlineBankPayment Boolean  @default(false)
  states                   String[] @default([])
  carriers                 String[] @default([])

  stateCarriers ExternalClientStateCarrier[]
  leads         Lead[]                       @relation("ExternalClientLeads")

  @@index([name])
}

// Per (external client, state) subset of that external client's carrier roster
// (ExternalClient.carriers) available in that state — same pattern as ClientStateCarrier
// above, just for the no-login bookkeeping-only client type.
model ExternalClientStateCarrier {
  id               String   @id @default(cuid())
  externalClientId String
  state            String
  carriers         String[] @default([])

  externalClient ExternalClient @relation(fields: [externalClientId], references: [id], onDelete: Cascade)

  @@unique([externalClientId, state])
  @@index([externalClientId])
}

// One row per message in a team channel. Soft-deleted (deletedAt) rather than removed so
// the timeline keeps its shape for anyone with the thread already open.
model ChatMessage {
  id        String    @id @default(cuid())
  room      ChatRoom
  senderId  String
  body      String
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Serves the room timeline query (room + newest-first) directly.
  @@index([room, createdAt])
  @@index([senderId])
}

// Read cursor per person per room — drives the unread badge in the sidebar.
model ChatRead {
  userId     String
  room       ChatRoom
  lastReadAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, room])
}
